# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must never be committed.

# Search keyword used on glints.com (e.g. "data analyst").
GLINTS_KEYWORD=data analyst

# Sender Gmail address used to send notification emails.
GLINTS_SENDER_EMAIL=you@gmail.com

# Gmail app password (NOT your normal password). Generate one at
# https://myaccount.google.com/apppasswords . Read from this env var only;
# it is never accepted as a CLI flag and never logged.
GLINTS_APP_PASSWORD=your-16-char-app-password

# Receiver Gmail address for notifications.
GLINTS_RECEIVER_EMAIL=recipient@gmail.com
